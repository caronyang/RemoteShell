{
  "name": "remoteshell",
  "version": "0.1.10",
  "private": true,
  "description": "RemoteShell - SSH/Telnet terminal with SFTP and jump host support",
  "author": "RemoteShell Team",
  "license": "UNLICENSED",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build:main && npm run build:preload && npm run build:renderer",
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.renderer.json --noEmit",
    "lint": "eslint src tests vite.config.ts --ext .ts,.tsx --max-warnings 0",
    "test": "node scripts/check-i18n-placeholders.mjs && node scripts/vitest.mjs",
    "test:coverage": "node scripts/vitest.mjs --coverage",
    "verify:i18n": "node scripts/check-i18n-placeholders.mjs",
    "verify:security": "node scripts/verify-security.mjs",
    "postinstall": "node scripts/strip-cpu-features.mjs",
    "dist": "npm run build && electron-builder --dir && node scripts/patch-exe.mjs",
    "make:setup": "node scripts/make-setup.mjs",
    "build:preload": "vite build --config vite.preload.config.ts",
    "verify:fonts": "node scripts/verify-fonts.mjs",
    "icon": "electron scripts/make-icon.cjs"
  },
  "dependencies": {
    "ssh2": "^1.17.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.7.5",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@types/ssh2": "^1.15.6",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitejs/plugin-react": "^4.3.2",
    "@vitest/coverage-v8": "^1.6.1",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/addon-webgl": "^0.18.0",
    "@xterm/xterm": "^5.5.0",
    "electron": "^32.3.3",
    "electron-builder": "^24.13.3",
    "eslint": "^8.57.1",
    "i18next": "^23.16.4",
    "jsdom": "^29.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^14.1.3",
    "typescript": "^5.6.3",
    "vite": "^5.4.9",
    "vitest": "^1.6.1"
  }
}
